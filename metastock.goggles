! name: MetaStock Core Search
! description: Excludes utility, script, and specific product paths from MetaStock.
! public: false
! author: MetaStock

! --- BLOCKED PATHS ---
/css/*$discard,domain=www.metastock.com
/js/*$discard,domain=www.metastock.com
/api/*$discard,domain=www.metastock.com
/search*$discard,domain=www.metastock.com
/sitemap.xml$discard,domain=www.metastock.com
/rss*$discard,domain=www.metastock.com
/products/realtime/eikon*$discard,domain=www.metastock.com

! --- BOOST REMAINING SITE ---
$boost=5,site=www.metastock.com
